# =============================================================================
# Jurexio Platform SDK — AWS / RDS template (NO SECRETS — names only)
# Nyayasiddhi production MUST NOT use this file. New host + new SSM path /jurexio/*.
# =============================================================================

JUREXIO_PLATFORM=1
NODE_ENV=production

# ── Gateway ──
NYV_PORT_GATEWAY=5000
NYV_PUBLIC_API_URL=https://api.<jurexio-domain>
NYV_CORS_ORIGINS=https://console.<jurexio-domain>

# ── Postgres (NEW database on account RDS — not database `nyayavigya`) ──
# After: bash scripts/jrx-provision-rds-database.sh (with admin URL from SSM)
# DATABASE_URL=postgres://jurexio_app:<from-ssm>@<rds-host>:5432/jurexio?sslmode=verify-full
# NYV_DATABASE_URL=<same>
# RDS_CA_BUNDLE=/opt/jurexio/certs/ap-south-1-bundle.pem

# ── Redis (dedicated instance or logical DB index — do not share NYV prod Redis) ──
# NYV_REDIS_TCP_URL=redis://:<auth>@<jurexio-redis-host>:6379/0

# ── SSM layout (create under separate prefix — never overwrite /nyv/* or /nyayavigya/*) ──
# /jurexio/prod/DATABASE_URL
# /jurexio/prod/NYV_JWT_SECRET
# /jurexio/prod/NYV_JWT_REFRESH_SECRET
# /jurexio/prod/NV_PII_ENCRYPTION_KEY
# /jurexio/prod/NYV_SDK_KEY_JRX
# /jurexio/prod/OPENAI_API_KEY
# /jurexio/prod/JRX_KNOWLEDGE_BASE_URL
# /jurexio/prod/JRX_KNOWLEDGE_API_KEY

# ── EC2 / deploy (new instance or new compose project — not nysdev i-0df71e5ea1df8f588) ──
# JRX_EC2_INSTANCE_ID=
# JRX_DEPLOY_ROOT=/opt/Jurexio
# JRX_SECRETS_FILE=/opt/Jurexio/secrets/.env.production
