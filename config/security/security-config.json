{
  "version": "5.0.0",
  "auth": {
    "jwt":   { "secretEnvVar": "JRX_JWT_SECRET",         "accessTtl": "24h",  "algo": "HS256", "rotationDays": 90 },
    "refresh":{ "secretEnvVar": "JRX_JWT_REFRESH_SECRET", "ttl": "30d" },
    "apiKey": { "format": "nyv_<env>_sk_<40>", "hash": "SHA-256", "store": "nv_sdk_keys" }
  },
  "rbac": { "levels": ["super-admin","org-admin","compliance-officer","manager","reviewer","creator","viewer","api-only"] },
  "csrf": { "enabled": true, "cookieName": "nyv_csrf", "headerName": "X-CSRF-Token" },
  "helmet": { "enabled": true, "csp": { "defaultSrc": ["'self'"], "scriptSrc": ["'self'"] }, "hsts": { "maxAge": 31536000 } },
  "guardrails": {
    "piiRedaction":      { "enabled": true, "patterns": ["aadhaar","pan","gstin","passport","phone-IN","credit-card","email","upi","ifsc","bank-account","driving-license","voter-id","biometric","ssn-US","nino-UK","tax-id-EU","iban","swift"], "applyTo": ["request","response"] },
    "promptInjection":   { "enabled": true, "modes": ["direct","role-play","token-smuggling","jailbreak","tool-abuse"] },
    "outputModeration":  { "enabled": true, "blockCategories": ["hate","sexual","self-harm","weapons","csam","extremism"] },
    "jurisdictionBinding":{ "enabled": true }
  },
  "piiVault": { "enabled": true, "encryption": "AES-256-GCM", "ttlMinutes": 30, "cleanupIntervalMin": 5 },
  "auditLog": { "enabled": true, "table": "nv_audit_logs", "hashChain": true, "retentionYears": 7 },
  "pqc": { "enabled": false, "library": "@open-quantum-safe/oqs-node", "kem": "ML-KEM-768", "sig": "ML-DSA-65", "altSig": "SLH-DSA-SHA2-128s" },
  "secretsManager": { "provider": "aws-secrets-manager", "rotationDays": 90 },
  "waf":  { "enabled": true, "provider": "aws-waf", "rules": ["SQLi","XSS","RFI","BotControl","RateLimitIP"] }
}
