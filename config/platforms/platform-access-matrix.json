    "activate":      "POST /api/nv/sdk/console/apps/:appId/activate",
    "revoke":        "POST /api/nv/sdk/console/apps/:appId/revoke",
    "createSubKey":  "POST /api/nv/sdk/console/apps/:appId/keys",
