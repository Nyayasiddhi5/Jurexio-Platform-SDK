# =============================================================================
# Nyayavigya Console — production build
# Monorepo layout: package.json + vite.config.ts at root, vite root = ./client
# =============================================================================
FROM node:22-alpine AS builder
WORKDIR /app

# Build deps (some npm packages compile native modules)
RUN apk add --no-cache python3 make g++ git

# 1) Install ALL deps (root package.json — vite, react, etc. all live here)
COPY package.json package-lock.json* ./
RUN npm install --no-audit --no-fund --legacy-peer-deps

# 2) Copy the bits the build actually needs
COPY vite.config.ts tsconfig.json* postcss.config.* tailwind.config.* ./
COPY client/   ./client/
COPY shared/   ./shared/
COPY src/      ./src/

# 3) Build → dist/public per vite.config.ts (outDir: '../dist/public')
RUN npx vite build

# =============================================================================
FROM nginx:1.27-alpine AS production
RUN rm /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist/public /usr/share/nginx/html
# NV-CONSOLE-ASSET-PERMS-001 (2026-06-24): vite copies client/public/* verbatim,
# preserving source file modes. A public asset committed with 0600 (e.g.
# nyayasiddhi-logo.png) is then unreadable by the unprivileged nginx worker and
# served as HTTP 403. Normalise read perms on the served tree so no static asset
# can 403 on a permission bit regardless of its mode in the repo.
RUN find /usr/share/nginx/html -type d -exec chmod 755 {} + \
 && find /usr/share/nginx/html -type f -exec chmod 644 {} +

RUN cat > /etc/nginx/conf.d/nyayavigya.conf << 'EOF'
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript image/svg+xml;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location /api/ {
        proxy_pass http://gateway:5000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # SDK tarball downloads — gateway issues 302 to S3 presigned URL.
    location /downloads/ {
        proxy_pass http://gateway:5000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location = /health {
        proxy_pass http://gateway:5000/health;
        proxy_set_header Host $host;
    }

    # Prometheus /metrics — restricted to internal docker bridge + RFC1918.
    # External Prom scrapers must use a VPN, SSH tunnel, or be on the same VPC.
    location = /metrics {
        allow 172.16.0.0/12;   # docker default bridge + compose networks
        allow 10.0.0.0/8;      # AWS VPC internal
        allow 192.168.0.0/16;  # corp/VPN ranges
        allow 127.0.0.1;
        deny  all;
        proxy_pass http://gateway:5000/metrics;
        proxy_set_header Host $host;
    }

    location /ws {
        proxy_pass http://gateway:5000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Canonical console routes — bare paths redirect to /console/*
    location ~ ^/(dashboard|sdk-hub|document-ai-hub|agent-registry|orchestration|superadmin|chat|model-catalog|intelligence|audit-chain|billing|org-admin|operations|platform-health-map|hitl-decision-cards|rbac-console|dpdpa-compliance|multimodal|create-agent|agent-live-testing|my-approvals|architect|live-activity-feed|rag-knowledge-base|statutes-citations|ocr-extraction|summarization|bulk-doc-upload|customer-orgs|command-centre|admin|login|home)(/|$|\?) {
        return 302 /console$request_uri;
    }
}
EOF

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:80/ || exit 1
CMD ["nginx", "-g", "daemon off;"]
