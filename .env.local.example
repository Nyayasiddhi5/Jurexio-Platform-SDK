# ============================================================
# Local Docker infra — copy these into .env when using:
#   npm run infra:local:up
#   (docker compose -f docker-compose.local.yml --profile local up -d)
# ============================================================

#   DATABASE_URL=postgres://nyayavigya:nyayavigya_local_dev@127.0.0.1:5432/nyayavigya?sslmode=disable
#   NYV_DATABASE_URL=postgres://nyayavigya:nyayavigya_local_dev@127.0.0.1:5432/nyayavigya?sslmode=disable
#
# Local Docker MUST use sslmode=disable (no TLS on compose Postgres).
# Production RDS template (EC2 / deploy bundle — do NOT use disable):
#   DATABASE_URL=postgres://nyvadmin:<password>@<rds-host>:5432/nyayavigya?sslmode=verify-full
#   NYV_DATABASE_URL=postgres://nyvadmin:<password>@<rds-host>:5432/nyayavigya?sslmode=verify-full
# Gateway upgrades prefer/require/verify-ca → verify-full when NYV_PG_SSL_VERIFY is unset.
# Opt out locally only: NYV_PG_SSL_VERIFY=false (see below).

NYV_REDIS_TCP_URL=redis://127.0.0.1:6379
REDIS_URL=redis://127.0.0.1:6379

NYV_STORAGE_BACKEND=local
NYV_CORS_ORIGINS=http://localhost:3004,http://localhost:5000,http://127.0.0.1:3004,http://127.0.0.1:5000

# macOS AirPlay Receiver often binds :5000 — use 5001 for gateway + export when starting console:
# NYV_PORT_GATEWAY=5001

NODE_ENV=development
NYV_PG_SSL_VERIFY=false

# Still required — generate locally; never commit real values:
# NYV_JWT_SECRET=...
# NYV_JWT_REFRESH_SECRET=...
# NV_PII_ENCRYPTION_KEY=...   (64 hex chars)
# NYV_SDK_KEY_NSP=...         (and NSPM, NSI, NSA, NSM, NYM, JRX)
# OPENAI_API_KEY=...          (at least one LLM provider for AI routes)

# ── OmniRoute AI gateway (last-mile fallback / cost saver) ──
# NV-OMNIROUTE-001: auto-enabled when OMNIROUTE_API_KEY is set; explicitly set
# NYV_OMNIROUTE_ENABLED=false to disable. NYV governance/PII is applied before
# the gateway is ever reached; task-level restrictions are handled by the
# orchestrator, not by the adapter.
# OMNIROUTE_API_KEY=...
# OMNIROUTE_BASE_URL=https://api.omniroute.ai/v1
# NYV_OMNIROUTE_ENABLED=true
# NYV_OMNIROUTE_ALLOWED_PLATFORMS=NSP,NYS,NYM,NSA,NSI,NSPM,JRX,MIN,INS
# NYV_OMNIROUTE_MAX_COST_USD=0.25

# ── Partner legal quality (no code change to retune) ──
# NYV_NSP_COUNSEL_QUEEN=1          # Legal Chat/draft → Queen+CoT (set 0 for grounded-fast SLA)
# NYV_LEGAL_COMPREHENSIVE=1        # Counsel-length + heading completeness
# NYV_LEGAL_HEADING_COMPLETE=1
# NYV_LEGAL_STRUCTURE_ATTACH=1  # attach stored IRAC/Prayer; LLM fills facts only
# AWS_BEDROCK_REGION=us-east-1
# NYV_BEDROCK_REGION_ORDER=us-east-1,ap-south-1
# NYV_PARTNER_LEGAL_PREMIUM_FIRST=0   # Bedrock default; set 1 for Claude/Gemini API first
# NYV_PARTNER_MAX_TOKENS_FLOOR=16384  # drafts / paper-book
# NYV_PARTNER_MAX_TOKENS_CHAT=8192    # legal chat / research
# NYV_PARTNER_MAX_TOKENS_FAST=2048    # extract / summarize / web-search
# NYV_PARTNER_LEGAL_PREMIUM_MODELS=us.anthropic.claude-opus-5,global.anthropic.claude-sonnet-5,gemini-3-1-pro-preview
# NYV_LLM_CASCADE_LEAD=us.anthropic.claude-opus-5,global.anthropic.claude-opus-4-8,global.anthropic.claude-sonnet-5,global.anthropic.claude-opus-4-7,global.anthropic.claude-sonnet-4-6,global.anthropic.claude-opus-4-6-v1
# NYV_PARTNER_RAG_TOP_K=16
# NYV_PARTNER_RAG_TIMEOUT_MS=45000
# NYV_NSP_UNLIMITED=1

# NYV_F_NYS_KNOWLEDGE_PLANE=1
# NYS_KNOWLEDGE_BASE_URL=https://nyayasearch.nyayasiddhi.online/api
# NYS_KNOWLEDGE_API_KEY=...          # must match NYS_SDK_API_KEYS on NYS worker
# NYS_KNOWLEDGE_TIMEOUT_MS=15000
# NYS_KNOWLEDGE_CB_FAILURES=5
# NYS_KNOWLEDGE_CB_COOLDOWN_MS=30000

# ── NYS-Search case-api (CNR resolve via nysapi — NV-CASE-API-001) ──
# NYS_CASE_API_BASE_URL=https://nysapi.nyayasiddhi.online
# NYS_CASE_API_KEY=...              # from AWS SM nyaya/case_api/http-api-keys (never commit)
# NYS_CASE_API_TIMEOUT_MS=30000
# NYV_F_CASE_API_CNR=1              # or NYS_CASE_API_ENABLED=1
# NYV_F_CASE_API_CNR_SHADOW=1       # log diff vs legacy; response stays legacy

# ── Phase 5 governance (local dev — documented, not forced ON in prod) ──
# NYV_F_AUDIT_WIRE=1            # IronLedger hash-chain wire (default ON in non-dev when unset)
# NYV_DPDPA_CONSENT_ENFORCE=0   # DPDPA consent gate observation mode (set 1 to enforce)
# NYV_JRX_GATE8_ENFORCE=0       # Bar Council Gate 8 — wired in safety-pipeline; off unless 1
# NV_PII_VAULT_ENABLED=1        # PII vault encryption at rest (requires NV_PII_ENCRYPTION_KEY)
# NYV_DOC_PROCESSOR_ENABLED=1   # production-doc-processor poller (needs ns_doc_processing_jobs table)

# ── NYS caselaw RDS TLS (worker + local probes) ──
# RDS_CA_BUNDLE=/opt/nyv/certs/rds-combined-ca-bundle.pem  # REQUIRED in production (rdsPool.ts enforces)
# Download: https://truststore.pki.rds.amazonaws.com/ap-south-1/ap-south-1-bundle.pem
# ATHENA_REGION=ap-south-1

# ── Docparse (local dev) ──
# NYV_F_DOCPARSE=1              # legacy @nyv/docparse ingest (default ON in non-dev)
# NYV_F_DOCPARSE_SDK=1          # Platform SDK line — dev only until parity cutover GO
# NYV_DOCPARSE_WORKER_PORT=5012 # optional sidecar: node scripts/nv-docparse-worker-sidecar.mjs
