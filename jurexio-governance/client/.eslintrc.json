{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module",
    "ecmaFeatures": { "jsx": true }
  },
  "plugins": ["@typescript-eslint"],
  "noInlineConfig": true,
  "rules": {},
  "overrides": [
    {
      "files": ["src/**/*.{ts,tsx,js,jsx}"],
      "excludedFiles": [
        "src/lib/nv-api-paths.ts",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.test.js",
        "**/*.test.jsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.spec.js",
        "**/*.spec.jsx"
      ],
      "rules": {
        "no-hardcoded-api-paths": "error"
      }
    }
  ],
  "ignorePatterns": ["dist/", "node_modules/"]
}
