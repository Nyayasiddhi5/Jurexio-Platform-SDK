# =============================================================================
# Jurexio Platform SDK — LOCAL environment (isolated from Nyayasiddhi / nysdev)
# Copy: bash scripts/jrx-init-local-env.sh
# Or:  cp .env.jurexio.local.example .env
# =============================================================================

JUREXIO_PLATFORM=1
NODE_ENV=development

# ── Ports (avoid clashing with Nyayavigya on same laptop) ──
NYV_PORT_GATEWAY=5010
# Console (when forked): 3010

# ── Public API (partners + @jurexio/client-sdk default) ──
# Gateway serves /api/jrx/* (alias → internal /api/nv/*). Do not disable unless debugging NYV paths.
# NYV_DISABLE_JRX_ALIAS=1

NYV_PUBLIC_API_URL=http://127.0.0.1:5010
NYV_CORS_ORIGINS=http://127.0.0.1:3010,http://localhost:3010,http://127.0.0.1:5010,http://localhost:5010

# ── Local infra (docker-compose.jurexio-local.yml) ──
JRX_LOCAL_PG_PORT=5433
JRX_LOCAL_REDIS_PORT=6380
NYV_PG_SSL_VERIFY=false

DATABASE_URL=postgres://jurexio:jurexio_local_dev@127.0.0.1:5433/jurexio?sslmode=disable
NYV_DATABASE_URL=postgres://jurexio:jurexio_local_dev@127.0.0.1:5433/jurexio?sslmode=disable

NYV_REDIS_TCP_URL=redis://127.0.0.1:6380
REDIS_URL=redis://127.0.0.1:6380

NYV_STORAGE_BACKEND=local

# ── Secrets (generated by jrx-init-local-env.sh — replace for shared dev) ──
# NYV_JWT_SECRET=
# NYV_JWT_REFRESH_SECRET=
# NV_PII_ENCRYPTION_KEY=   # 64 hex chars
# NYV_SDK_KEY_JRX=         # gateway sdk_applications seed / partner smoke

# ── LLM (at least one provider for AI routes) ──
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# ── Jurexio knowledge federation (optional until JRX worker is deployed) ──
# Do NOT point at nyayasearch.nyayasiddhi.online in production Jurexio tenants.
# JRX_KNOWLEDGE_BASE_URL=https://knowledge.<jurexio-domain>/api
# JRX_KNOWLEDGE_API_KEY=
# NYV_F_NYS_KNOWLEDGE_PLANE=0

# ── NYS in-tree worker (local) — separate from Nyayasiddhi caselaw RDS ──
# NYS uses its own DATABASE_URL in NYS-Agentic-AI when you run the worker locally.
# NYV_API_BASE_URL=http://127.0.0.1:5010
# NYV_SDK_KEY_JRX=...      # same as gateway seed key for CNR SSOT via /api/jrx/
