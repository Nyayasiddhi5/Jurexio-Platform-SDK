{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist/server",
    "rootDir": "./jurexio-sdk",
    "noEmit": false,
    "noEmitOnError": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "removeComments": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": false
  },
  "include": ["jurexio-sdk/src/**/*", "jurexio-sdk/shared/**/*", "jurexio-sdk/server/**/*"],
  "exclude": ["node_modules", "dist", "jurexio-governance/client", "tests", "**/*.test.ts", "**/*.spec.ts", "jurexio-sdk/src/__tests__/**"]
}
