{
  "cli": { "version": ">= 5.9.0" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "production": {
      "android": { "buildType": "app-bundle" },
      "ios": { "autoIncrement": "buildNumber" }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "serviceAccountKeyPath": "./play-store-service-account.json"
      },
      "ios": {
        "appleId": "store-submitter@jurexio.com",
        "ascAppId": "REPLACE_WITH_APPSTORE_CONNECT_ID"
      }
    }
  }
}
