{
  "expo": {
    "name": "NSP Mobile (sample)",
    "slug": "nsp-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": { "backgroundColor": "#ffffff", "resizeMode": "contain" },
    "ios": {
      "bundleIdentifier": "in.nyayavigya.examples.nspmobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Used to scan legal documents for OCR analysis.",
        "NSMicrophoneUsageDescription": "Used to capture voice queries for the Sarvam voice agent.",
        "NSPhotoLibraryUsageDescription": "Used to attach existing PDFs / images to your queries."
      }
    },
    "android": {
      "package": "in.nyayavigya.examples.nspmobile",
      "adaptiveIcon": { "backgroundColor": "#ffffff" },
      "permissions": ["CAMERA", "RECORD_AUDIO", "READ_MEDIA_IMAGES", "READ_MEDIA_VIDEO", "POST_NOTIFICATIONS"]
    },
    "extra": {
      "JRX_BASE_URL": "https://api.nyayavigya.com"
    },
    "plugins": [
      "expo-secure-store",
      "expo-camera",
      "expo-av",
      "expo-image-picker",
      "expo-notifications"
    ]
  }
}
