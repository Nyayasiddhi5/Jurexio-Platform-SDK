{
  "$schema": "../scenario.schema.json",
  "jurisdiction": "US",
  "category": "ocr-multilingual",
  "scenarios": [
    {
      "id": "US-OCR-001",
      "title": "Scanned deposition transcript — 200 page OCR + Q/A indexing",
      "userRole": "lawyer-pro",
      "sdkVariant": "nsp-web",
      "pattern": "P11",
      "request": {
        "method": "POST",
        "path": "/api/jrx/gateway/ocr/process",
        "auth": "sdk-key",
        "body": {
          "imageUrl": "https://example.com/sample-doc.png",
          "fileName": "document.png",
          "options": {
            "language": "en",
            "extractText": true,
            "detectLayout": true
          }
        }
      },
      "expected": {
        "httpStatus": 200,
        "mustHaveFields": [
          "success",
          "data.text",
          "data.confidence"
        ]
      },
      "passCriteria": ">=0.95 confidence on printed transcript; Q/A pairs indexed with line:page anchors; speaker labels preserved.",
      "costSensitive": true
    },
    {
      "id": "US-OCR-002",
