{
  "$schema": "../scenario.schema.json",
  "jurisdiction": "US",
  "category": "contract-review",
  "scenarios": [
    {
      "id": "US-CON-001",
      "title": "DPA review under CCPA + HIPAA (cloud vendor processing PHI)",
      "userRole": "enterprise-counsel",
      "sdkVariant": "nspm-enterprise",
      "pattern": "P05",
      "request": {
        "method": "POST",
        "path": "/api/jrx/gateway/documents/analyze",
        "auth": "sdk-key",
        "body": {
          "content": "{\"jurisdiction\":\"US\",\"contractType\":\"data_processing_addendum\",\"documentRef\":\"fixtures/US/dpa-cloud-vendor.pdf\",\"applicableLaws\":[\"CCPA\",\"HIPAA\",\"HITECH\"]}",
          "type": "contract-review",
          "jurisdiction": "US"
        }
      },
      "expected": {
        "httpStatus": 200,
        "mustContainAtLeast": {
          "count": 2,
          "of": [
            "business associate",
            "minimum necessary",
            "breach notification",
            "service provider"
          ]
        },
        "mustHaveFields": [
          "success",
          "data.requestId"
        ]
      },
      "passCriteria": "Identifies BAA elements; CCPA service-provider vs contractor distinction; 60-day breach notification; subprocessor flow-down."
    },
    {
      "id": "US-CON-002",
      "title": "Vendor MSA with broad indemnity + liability cap (SaaS B2B)",
      "userRole": "enterprise-counsel",
      "sdkVariant": "nspm-enterprise",
      "pattern": "P05",
      "request": {
        "method": "POST",
        "path": "/api/jrx/gateway/documents/analyze",
        "auth": "sdk-key",
        "body": {
          "content": "{\"jurisdiction\":\"US\",\"contractType\":\"msa\",\"documentRef\":\"fixtures/US/msa-saas-b2b.pdf\",\"reviewMode\":\"red-flag\"}",
          "type": "contract-review",
          "jurisdiction": "US"
        }
      },
      "expected": {
        "httpStatus": 200,
        "mustContainAtLeast": {
          "count": 2,
          "of": [
            "limitation of liability",
            "indemnification",
            "carve-outs",
            "consequential damages"
          ]
        },
        "mustHaveFields": [
          "success",
          "data.requestId"
        ]
      },
      "passCriteria": "Flags asymmetric indemnity; calls out IP-infringement carve-outs; suggests super-cap for IP/data breach; UCC Art. 2 vs common-law framing."
    },
    {
      "id": "US-CON-003",
      "title": "Stock Purchase Agreement (target due diligence + reps & warranties)",
      "userRole": "enterprise-counsel",
      "sdkVariant": "nspm-enterprise",
      "pattern": "P05",
      "request": {
        "method": "POST",
        "path": "/api/jrx/gateway/documents/analyze",
        "auth": "sdk-key",
        "body": {
          "content": "{\"jurisdiction\":\"US\",\"contractType\":\"spa\",\"documentRef\":\"fixtures/US/spa-target-co.pdf\",\"dealSize\":75000000,\"state\":\"DE\"}",
          "type": "contract-review",
          "jurisdiction": "US"
        }
      },
      "expected": {
        "httpStatus": 200,
        "mustContainAtLeast": {
          "count": 2,
          "of": [
            "representations and warranties",
            "indemnification basket",
            "survival period",
            "MAE"
          ]
        },
        "mustHaveFields": [
          "success",
          "data.requestId"
        ]
      },
      "passCriteria": "Validates DGCL applicability; basket / cap / survival reasonable; MAE definition exclusions; sandbagging clause flagged."
    },
    {
      "id": "US-CON-004",
      "title": "Employment offer + non-compete (DTSA + state-law check, e.g. CA vs FL)",
      "userRole": "enterprise-counsel",
      "sdkVariant": "nspm-enterprise",
      "pattern": "P05",
      "request": {
        "method": "POST",
        "path": "/api/jrx/gateway/documents/analyze",
        "auth": "sdk-key",
        "body": {
          "content": "{\"jurisdiction\":\"US\",\"contractType\":\"employment_offer\",\"documentRef\":\"fixtures/US/offer-vp-engineering.pdf\",\"state\":\"CA\",\"compareStates\":[\"CA\",\"FL\",\"TX\"]}",
          "type": "contract-review",
          "jurisdiction": "US"
        }
      },
      "expected": {
        "httpStatus": 200,
        "mustContainAtLeast": {
          "count": 2,
          "of": [
            "B&P 16600",
            "non-compete",
            "DTSA",
            "trade secret"
          ]
        },
        "mustHaveFields": [
          "success",
          "data.requestId"
        ]
      },
      "passCriteria": "Notes CA non-compete unenforceability (B&P 16600); FL/TX reasonableness test; DTSA whistleblower notice required."
    },
    {
      "id": "US-CON-005",
      "title": "Mutual NDA — DTSA + state UTSA harmonisation",
      "userRole": "enterprise-counsel",
      "sdkVariant": "nspm-enterprise",
      "pattern": "P05",
      "request": {
        "method": "POST",
        "path": "/api/jrx/gateway/documents/analyze",
        "auth": "sdk-key",
        "body": {
          "content": "You are a senior legal AI assistant for US jurisdiction.\n\n  Question: Mutual NDA — DTSA + state UTSA harmonisation\n\n  Provide a structured legal analysis including:\n  1. The applicable statute / regulation / case law (cite specific section numbers).\n  2. The legal test or compliance threshold that triggers the rule.\n  3. Step-by-step reasoning applied to the facts implied by the question.\n  4. The specific compliance action, filing, disclosure, or remedy required.\n  5. Material risks or exceptions a practitioner should flag to the client.\n\n  Be concrete. Cite specific legal authorities. Avoid generic disclaimers.",
          "type": "contract-review",
          "jurisdiction": "US"
        }
      },
      "expected": {
        "httpStatus": 200,
        "mustContainAtLeast": {
          "count": 2,
          "of": [
            "confidential information",
            "DTSA",
            "18 U.S.C. § 1833",
            "whistleblower"
          ]
        },
        "mustHaveFields": [
          "success",
          "data.requestId"
        ]
      },
      "passCriteria": "Validates DTSA whistleblower notice (else lose exemplary damages); residual-knowledge clause flagged.",
      "costSensitive": true
    }
  ]
}