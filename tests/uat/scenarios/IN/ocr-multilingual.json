{
  "$schema": "../scenario.schema.json",
  "jurisdiction": "IN",
  "category": "ocr-multilingual",
  "scenarios": [
    {
      "id": "IN-OCR-001",
      "title": "Hindi handwritten affidavit — 5 page OCR + summary",
      "userRole": "lawyer-pro",
      "sdkVariant": "nsp-web",
      "pattern": "P11",
      "request": {
        "method": "POST",
        "path": "/api/jrx/gateway/ocr/process",
        "auth": "sdk-key",
        "body": {
          "imageUrl": "https://example.com/sample-doc.png",
          "fileName": "document.png",
          "options": {
            "language": "en",
            "extractText": true,
            "detectLayout": true
          }
        }
      },
      "expected": {
        "httpStatus": 200,
        "mustHaveFields": [
          "success",
          "data.text",
          "data.confidence"
        ]
      },
      "passCriteria": "Confidence >= 0.75; engine cascades from GOT-OCR → GPT-4o vision on degraded pages; summary in EN + HI; PII redacted in summary.",
      "costSensitive": true
    },
    {
      "id": "IN-OCR-002",
