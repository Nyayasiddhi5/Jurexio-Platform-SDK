    {
      "id": "IN-OCR-004",
      "title": "Mixed-script (Hindi + English) — 500 page lease bundle",
      "userRole": "enterprise-counsel",
      "sdkVariant": "nspm-enterprise",
      "pattern": "P11",
      "request": {
        "method": "POST",
        "path": "/api/jrx/gateway/ocr/process",
        "auth": "sdk-key",
        "body": {
          "imageUrl": "https://example.com/sample-doc.png",
          "fileName": "document.png",
          "options": {
            "language": "en",
            "extractText": true,
            "detectLayout": true
          }
        }
      },
      "expected": {
        "httpStatus": [200, 202],
        "mustHaveFields": [
          "success"
        ]
      },
      "passCriteria": "Sync (200) for ≤5MB or async-accept (202) for larger bundles; per-page language auto-detected; final JSON has scriptDistribution map."
