{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Jurexio UAT real-world scenario file",
  "type": "object",
  "required": ["jurisdiction", "category", "scenarios"],
  "properties": {
    "$schema": { "type": "string" },
    "jurisdiction": { "type": "string", "enum": ["IN", "UK", "US", "GC", "EU", "SG"] },
    "category": {
      "type": "string",
      "enum": [
        "litigation-drafting",
        "contract-review",
        "regulatory",
        "case-research",
        "ocr-multilingual",
        "hitl-safety"
      ]
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "request", "expected", "passCriteria"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z]{2}-(LIT|CON|REG|RES|OCR|SAF)-\\d{3}$" },
          "title": { "type": "string" },
          "userRole": {
            "type": "string",
            "enum": ["lawyer-pro", "citizen-mitra", "enterprise-counsel", "paralegal", "super-admin"]
          },
          "sdkVariant": { "type": "string" },
          "pattern": { "type": "string", "pattern": "^P\\d{2}$" },
          "request": {
            "type": "object",
            "required": ["method", "path"],
            "properties": {
              "method": { "type": "string", "enum": ["GET", "POST", "PUT", "DELETE"] },
              "path": { "type": "string" },
              "auth": { "type": "string", "enum": ["jwt", "sdk-key", "inter-secret", "none"] },
              "body": {},
              "headers": { "type": "object" },
              "query": { "type": "object" }
            }
          },
          "expected": {
            "type": "object",
            "properties": {
              "httpStatus": {
                "oneOf": [
                  { "type": "integer" },
                  { "type": "array", "items": { "type": "integer" } }
                ]
              },
              "mustHaveFields": { "type": "array", "items": { "type": "string" } },
              "mustContainText": { "type": "array", "items": { "type": "string" } },
              "mustContainAnyOf": { "type": "array", "items": { "type": "string" } },
              "mustContainAtLeast": {
                "type": "object",
                "properties": {
                  "count": { "type": "integer", "minimum": 1 },
                  "of": { "type": "array", "items": { "type": "string" } }
                },
                "required": ["count", "of"]
              },
              "mustNotContainText": { "type": "array", "items": { "type": "string" } },
              "mustHaveLowConfidenceRoute": { "type": "boolean" },
              "timeoutMs": { "type": "integer" }
            }
          },
          "passCriteria": { "type": "string" }
        }
      }
    }
  }
}
