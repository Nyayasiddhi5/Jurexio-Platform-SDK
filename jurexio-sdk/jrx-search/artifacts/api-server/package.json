{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "seed": "tsx ./src/seed.ts",
    "seed:ensure": "tsx ./src/seed-if-empty.ts",
    "seed:caselaw": "tsx ./src/seed-caselaw.ts",
    "seed:statutes": "tsx ./src/seed-statutes.ts",
    "seed:templates": "tsx ./src/seed-templates.ts",
    "embed:corpus": "tsx ./src/embed-corpus.ts",
    "embed:statutes": "tsx ./src/embed-statutes.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:statutes": "vitest run src/__tests__/seed-statutes-integrity.test.ts",
    "check:seeds": "vitest run src/__tests__/seed-integrity.test.ts",
    "check:devdata": "tsx ./src/check-devdata.ts",
    "rds:ddl": "tsx src/rds-ddl.ts",
    "rds:ingest": "tsx src/ingest-rds.ts",
    "rds:ingest-cnr-details": "tsx src/ingest-cnr-case-details.ts",
    "cnr:sync": "tsx src/ingest-cnr-case-details.ts",
    "seed:constitution": "tsx ./src/seed-constitution.ts",
    "ingest:indiacode": "tsx ./src/ingest-india-code.ts --retry-failed",
    "ingest:indiacode-pdf": "tsx ./src/ingest-india-code-pdf.ts",
    "ingest:indiacode:refresh": "tsx ./src/ingest-india-code.ts --refresh",
    "ingest:indiacode:refresh:stale": "tsx ./src/ingest-india-code.ts --refresh --force-stale-days 90",
    "ingest:usc": "tsx ./src/ingest-usc-titles.ts --titles priority",
    "export:statutes-delta": "tsx ./src/export-statutes-delta.ts",
    "check:constitution": "vitest run src/__tests__/seed-constitution-integrity.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-athena": "^3.1080.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1080.0",
    "@aws-sdk/client-rds": "^3.1080.0",
    "@aws-sdk/client-s3": "^3.1080.0",
    "@aws-sdk/client-secrets-manager": "^3.1080.0",
    "@aws-sdk/s3-request-presigner": "^3.1080.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-anthropic-ai": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "hyparquet": "^1.26.2",
    "mammoth": "^1.12.0",
    "pdf-to-img": "^6.2.0",
    "pg": "^8.22.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.6.2",
    "yaml": "^2.9.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@workspace/nyv-sdk": "workspace:*",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "thread-stream": "3.1.0",
    "tsx": "catalog:",
    "vitest": "^4.1.10"
  }
}
