{
  "$schema": "./schema/jrx-master-config.schema.json",
  "platform": {
    "name": "Jurexio",
    "version": "3.1.2",
    "sdkVersion": "5.0.0",
    "frozen": true,
    "productionDate": "2026-05-15",
    "primaryRegion": "ap-south-1",
    "drRegion": "ap-southeast-1",
    "apiBasePath": "/api/nv",
    "ports": { "gateway": 5000, "console": 3004, "voiceWs": 5000 }
  },
  "modules": {
    "agents":            { "enabled": true,  "configFile": "config/agents/agents-master.json" },
    "patterns":          { "enabled": true,  "count": 22, "list": ["react","cot","tot","reflection","plan-execute","refine","maker-checker","tool-retry","function-router","mcp-chain","nyayarag","graphrag","mem0","semantic-cache","hta","swarm","aconic","moat","adapt","computer-use","grpo","digital-twin"] },
    "algorithms":        { "enabled": true,  "list": ["ALG-01","ALG-02","ALG-03","ALG-04","ALG-05","ALG-06","ALG-07","ALG-08"] },
    "nyayaTools":        { "enabled": true,  "list": ["graph","watch","compare","template","timeline","forensic","trail","amend"] },
    "intelligence":      { "enabled": true,  "list": ["conflict-detect","amendment-impact","precedent-similarity","regulatory-feed","secure-collaboration","litigation-risk-v2"] },
    "rag":               { "enabled": true,  "engines": ["nyayarag","graphrag","lightrag","adaptive","corrective","self"] },
    "documentPipeline":  { "enabled": true },
    "voice":             { "enabled": true,  "languages": 47 },
    "memory5Tier":       { "enabled": true },
    "billing":           { "enabled": true,  "currency": "INR", "gstRate": 0.18 },
    "compliance":        { "enabled": true,  "standards": ["DPDPA-2023","GDPR","EU-AI-Act","SOC-2","ISO-42001","ISO-27001"] },
    "pqc":               { "enabled": true,  "mode": "auto" },
    "hitl":              { "enabled": true },
    "testing6Layer":     { "enabled": true },
    "agui":              { "enabled": true,  "transport": "sse" },
    "mcp":               { "enabled": true,  "tools": 502 }
  },
  "agents": {
    "registriesPath": "src/data/jurisdiction-registries",
    "baseRegistry": "src/data/jurisdiction-registries/Jurexio-Legal-registry-Default.json",
    "totalAgents": 1042,
    "perJurisdiction": 148,
    "jurisdictions": ["IN","UK","US","EU","GC","SG","DEFAULT"],
    "selector": "bm25",
    "personaSections": 22,
    "grpoDimensions": 7,
    "romaLevels": 5,
    "systemPromptOverridesFile": "config/agents/system-prompts.json"
  },
  "llm": { "configFile": "config/llm/llm-config.json" },
  "rateLimits": { "configFile": "config/rate-limits/rate-limits.json" },
  "memory": { "configFile": "config/memory/memory-config.json" },
  "storage": { "configFile": "config/storage/storage-config.json" },
  "cache": { "configFile": "config/cache/cache-config.json" },
  "security": { "configFile": "config/security/security-config.json" },
  "integrations": { "configFile": "config/integrations/integrations.json" },
  "platforms": { "configFile": "config/platforms/platform-access-matrix.json" },
  "observability": {
    "logging": { "format": "json", "level": "info", "requestIdHeader": "X-Request-ID" },
    "metrics": { "provider": "cloudwatch", "namespace": "Jurexio/3.1.2" },
    "tracing": { "provider": "otel", "exporter": "otlp" },
    "errorMonitoring": { "provider": "sentry", "envVar": "SENTRY_DSN" }
  },
  "deployment": {
    "target": "aws-eks",
    "imageRegistry": "ECR",
    "namespace": "nyayavigya",
    "replicas": { "gateway": 6, "console": 3, "worker": 4 },
    "autoscaling": { "min": 3, "max": 60, "cpuTarget": 65 }
  }
}
