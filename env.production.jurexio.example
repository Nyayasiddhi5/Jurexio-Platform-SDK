# Local operator file — copy to env.production.jurexio (gitignored). NO secret values in git.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Greenfield US production default; override for ap-south pilot only.
JRX_AWS_REGION=us-east-1
JRX_EC2_INSTANCE_ID=
JRX_DEPLOY_BUCKET=jurexio-deploy-artifacts
JRX_DEPLOY_ROOT=/opt/Jurexio
JRX_SECRETS_FILE=/opt/Jurexio/secrets/.env.production

# SSM destination prefix (gateway reads /jurexio/prod/* only)
JRX_SSM_DEST_PREFIX=/jurexio/prod

# Bedrock smoke bootstrap — JRX-native param names under JRX_SSM_DEST_PREFIX:
#   JRX_BEDROCK_ENABLED, JRX_ROUTER_BEDROCK_FIRST, AWS_BEDROCK_REGION,
#   JRX_BEDROCK_REGION_ORDER, BEDROCK_MODEL_ID (+ AWS creds if stored in SSM)
#
# Phase D — A2A HMAC (required in production multi-agent deployments)
# A2A_HMAC_SECRET=

# Optional one-time copy from legacy Nyayavigya SSM (default OFF for greenfield US):
# JRX_SSM_COPY_FROM_NYV=1
# JRX_SSM_SOURCE_PREFIX=/nyayavigya/dev
