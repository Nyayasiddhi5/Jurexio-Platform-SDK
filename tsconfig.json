{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "downlevelIteration": true,
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["./shared/*"],
      "@nyv/docparse": ["./packages/docparse/src/index.ts"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noImplicitAny": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "src/orchestration/nv-orchestration-facade.ts",
    "src/services/nyayamitra-service.ts",
    "src/packages/security/security-audit-persistence-service.ts",
    "src/packages/protocols/bmad/agents.ts",
    "src/packages/protocols/agui-nyayavigya-integration-service.ts",
    "src/packages/protocols/nyayavigya-agui-event-bridge.ts",
    "src/packages/multimodal/avatar-3d-system.ts",
    "src/packages/multimodal/chatdollkit-avatar-service.ts",
    "src/packages/multimodal/computer-vision-api.ts",
    "src/packages/multimodal/enhanced-multimodal-service.ts",
    "src/packages/multimodal/unity-avatar-service.ts",
    "src/packages/multimodal/advanced-3d-immersive-api.ts",
    "src/packages/multimodal/advanced-multimodal-rag.ts",
    "src/packages/multimodal/hd-video-generator.ts",
    "src/packages/multimodal/professional-video-script-generator.ts",
    "src/packages/multimodal/video-assembler.ts",
    "src/packages/multimodal/video-script-generator.ts",
    "src/packages/voice/voice-synthesis-engine.ts",
    "src/packages/voice/voiceover-generator.ts",
    "src/packages/voice/realtime-voice-streaming.ts",
    "src/packages/workflows/autonomous-continuous-execution-engine.ts",
    "src/packages/workflows/continuous-execution-engine.ts"
  ]
}
