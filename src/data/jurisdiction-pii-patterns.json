{
  "_meta": {
    "version": "1.0.0",
    "owner": "Jurexio Enterprise Platform SDK v5.0.0 — Phase C / T-06a",
    "note": "Config-only. Change patterns here — zero code changes needed for jurisdiction updates.",
    "consumed_by": "src/services/safety-pipeline.ts (loadJCNPatterns) — extends the 30+ India patterns when JRX_F_PII_JCN=1",
    "regex_flags": "g",
    "redaction_token_format": "[<JCN>-<KEY>-REDACTED]"
  },
  "JCN-UK": {
    "nhs_number":      "\\b\\d{3}[- ]\\d{3}[- ]\\d{4}\\b",
    "uk_nino":         "\\b[A-CEGHJ-PR-TW-Z]{2}\\d{6}[A-D]\\b",
    "uk_driving_lic":  "\\b[A-Z]{5}\\d{6}[A-Z0-9]{2}\\d[A-Z]{2}\\b",
    "uk_iban":         "\\bGB\\d{2}[A-Z]{4}\\d{14}\\b",
    "uk_sort_account": "\\b\\d{2}-\\d{2}-\\d{2}\\s\\d{8}\\b",
    "uk_brp_number":   "\\b[A-Z]{2}[X\\d]\\d{6}\\b",
    "uk_passport":     "\\b[A-Z]{2}\\d{7}\\b"
  },
  "JCN-US": {
    "us_passport":     "\\b[A-Z]\\d{8}\\b",
    "us_ein":          "\\b\\d{2}-\\d{7}\\b",
    "us_medicare":     "\\b[0-9A-Z]{11}\\b",
    "us_routing":      "\\b\\d{9}\\b",
    "us_itin":         "\\b9\\d{2}-[7-9]\\d-\\d{4}\\b"
  },
  "JCN-GCC": {
    "uae_emirates_id": "\\b784-\\d{4}-\\d{7}-\\d\\b",
    "ksa_national_id": "\\b[12]\\d{9}\\b",
    "qatar_national":  "\\b\\d{11}\\b",
    "kuwait_civil":    "\\b\\d{12}\\b",
    "bahrain_cpr":     "\\b\\d{9}\\b",
    "oman_national":   "\\b[1-3]\\d{7}\\b"
  },
  "JCN-SG": {
    "sg_nric_fin":  "\\b[STFG]\\d{7}[A-Z]\\b",
    "sg_passport":  "\\b[A-Z]\\d{8}[A-Z]\\b",
    "sg_uen":       "\\b\\d{9}[A-Z]\\b",
    "sg_fin":       "\\b[FGWM]\\d{7}[A-Z]\\b"
  }
}
